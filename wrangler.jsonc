{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tsukue-no-hi",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "tsukue-no-hi.yhay81.com",
      "custom_domain": true,
    },
  ],
  "triggers": {
    "crons": ["17 19 * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tsukue-no-hi",
      "database_id": "adfd4382-ca1a-4828-9d69-15ea6f981f25",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
}
